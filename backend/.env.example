# Port mapping (default: 5001)
PORT=5001

# MongoDB Connection String (defaults to local MongoDB instance)
MONGO_URI=mongodb://localhost:27017/intuneDB

# Required: generate a unique random secret of at least 32 bytes.
# Example command: openssl rand -base64 32
JWT_SECRET=

# Shared secret sent by the external webhook provider
WEBHOOK_SECRET=replace-with-your-webhook-secret

# SBERT AI similarity microservice API URL (defaults to FastAPI port 8000)
AI_SIMILARITY_URL=http://localhost:8000/api/similarity
